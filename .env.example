# ---------------------------------------------------------------------------
# FACTORY PLANNER - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ---------------------------------------------------------------------------
# Copy this file to '.env' and fill in your actual Google Cloud configurations.
# NEVER commit the actual '.env' file containing your secrets to Git.

# Interruptor de Modo Offline/Local-First (true = 100% local sin GCP, false = producción en la nube)
OFFLINE_MODE=true

# ---------------------------------------------------------------------------
# MODELO LLM (LiteLLM proxy — por defecto Claude via proxy corporativo)
# ---------------------------------------------------------------------------
# Obtén tu API key del bot de Slack #cloud-ai-ngineering
ANTHROPIC_AUTH_TOKEN=sk-your-api-key-here
ANTHROPIC_BASE_URL=https://llm.tools.cloud.masorange.es
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-5

# ---------------------------------------------------------------------------
# GCP (solo necesario si usas Vertex AI directamente en lugar del proxy)
# ---------------------------------------------------------------------------
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west1

# Nombre del Bucket de Google Cloud Storage (GCS) para almacenar Skills, Schedules y Reportes
GCS_SKILLS_BUCKET=your-gcs-skills-bucket-name

# URL del servidor MCP remoto desplegado en Cloud Run (tu propio servidor MCP)
MCP_SERVER_URL=https://your-mcp-server-xxxxxx.a.run.app

# URL de conexión del Agente Colaborador (Partner) Remoto (Protocolo A2A)
PARTNER_AGENT_URL=https://your-partner-agent-service-xxxxxx.a.run.app/v2-adk-stateless
